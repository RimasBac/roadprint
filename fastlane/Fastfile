default_platform(:ios)

APP_ID = "com.rimasbac.roadprint"
SCHEME = "RoadPrint"
XCODEPROJ = "RoadPrint.xcodeproj"

ASC_ENV = %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_P8].freeze

# Lanes that build and sign (macOS).
BUILD_ENV = (ASC_ENV + %w[
  APPLE_TEAM_ID MATCH_PASSWORD MATCH_GIT_URL MATCH_GIT_BASIC_AUTHORIZATION
]).freeze

# external_beta (Linux): ASC keys plus the Beta App Review contact.
DISTRIBUTE_ENV = (ASC_ENV + %w[
  BETA_CONTACT_FIRST_NAME BETA_CONTACT_LAST_NAME BETA_CONTACT_EMAIL BETA_CONTACT_PHONE
]).freeze

BETA_GROUP = "Board device"
BETA_LINK_LIMIT = 5

def require_env!(names = BUILD_ENV)
  missing = names.select { |k| ENV[k].to_s.strip.empty? }
  UI.user_error!("Missing secrets: #{missing.join(', ')}. See docs/BUILD_PIPELINE.md.") unless missing.empty?
end

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_content: ENV["ASC_KEY_P8"],
    in_house: false
  )
end

platform :ios do
  desc "One-time: create the distribution certificate and App Store profile in roadprint-certs"
  lane :bootstrap_signing do
    require_env!(BUILD_ENV)
    setup_ci
    api_key = asc_api_key
    match(type: "appstore", readonly: false, api_key: api_key)
  end

  desc "Build a signed app and upload it to TestFlight"
  lane :beta do
    require_env!(BUILD_ENV)
    setup_ci
    api_key = asc_api_key
    match(type: "appstore", readonly: true, api_key: api_key)

    sh("cd .. && xcodegen generate")

    build_number =
      if ENV["GITHUB_RUN_NUMBER"].to_s.strip.empty?
        latest_testflight_build_number(api_key: api_key, app_identifier: APP_ID) + 1
      else
        ENV["GITHUB_RUN_NUMBER"].to_i
      end

    profile = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING][APP_ID]
    update_code_signing_settings(
      use_automatic_signing: false,
      path: XCODEPROJ,
      targets: [SCHEME],
      team_id: ENV["APPLE_TEAM_ID"],
      code_sign_identity: "Apple Distribution",
      profile_name: profile
    )

    build_app(
      project: XCODEPROJ,
      scheme: SCHEME,
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: { APP_ID => profile }
      },
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number}",
      output_directory: "build",
      buildlog_path: "build/logs"
    )

    # Size only: the .ipa itself never leaves the runner except to Apple.
    File.write("../build/ipa-size.txt", "#{File.size(lane_context[SharedValues::IPA_OUTPUT_PATH])} bytes, build #{build_number}\n")

    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end

  desc "Give a processed build to the external group 'Board device' and submit it to Beta App Review (Linux, no Xcode)"
  lane :external_beta do
    require_env!(DISTRIBUTE_ENV)
    build_number = ENV["BUILD_NUMBER"].to_s.strip
    UI.user_error!("BUILD_NUMBER is required.") if build_number.empty?
    api_key = asc_api_key

    version = File.read("../project.yml")[/MARKETING_VERSION:\s*"?([0-9.]+)"?/, 1]
    UI.user_error!("Cannot read MARKETING_VERSION from project.yml.") if version.nil?

    app = Spaceship::ConnectAPI::App.find(APP_ID)
    UI.user_error!("App #{APP_ID} not found in App Store Connect.") if app.nil?

    # Idempotent: create the external group once, then make sure its public link is on with the limit.
    group = app.get_beta_groups.find { |g| g.name == BETA_GROUP }
    if group.nil?
      group = app.create_beta_group(
        group_name: BETA_GROUP,
        is_internal_group: false,
        public_link_enabled: true,
        public_link_limit_enabled: true,
        public_link_limit: BETA_LINK_LIMIT
      )
    elsif !group.public_link_enabled || !group.public_link_limit_enabled || group.public_link_limit != BETA_LINK_LIMIT
      group.update(attributes: {
        public_link_enabled: true,
        public_link_limit_enabled: true,
        public_link_limit: BETA_LINK_LIMIT
      })
      group = app.get_beta_groups.find { |g| g.name == BETA_GROUP }
    end

    read = ->(name) { File.read(File.join(__dir__, "beta", name)).strip }

    # No individual testers are added or looked up: access is by the public link only.
    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_ID,
      distribute_only: true,
      build_number: build_number,
      app_version: version,
      distribute_external: true,
      groups: [BETA_GROUP],
      notify_external_testers: false,
      submit_beta_review: true,
      changelog: read.call("what_to_test.txt"),
      beta_app_description: read.call("description.txt"),
      beta_app_feedback_email: ENV["BETA_CONTACT_EMAIL"],
      beta_app_review_info: {
        contact_email: ENV["BETA_CONTACT_EMAIL"],
        contact_first_name: ENV["BETA_CONTACT_FIRST_NAME"],
        contact_last_name: ENV["BETA_CONTACT_LAST_NAME"],
        contact_phone: ENV["BETA_CONTACT_PHONE"],
        demo_account_required: false,
        notes: read.call("review_notes.txt")
      }
    )

    link = app.get_beta_groups.find { |g| g.name == BETA_GROUP }&.public_link
    UI.important("Public TestFlight link for '#{BETA_GROUP}': #{link || 'not available yet'}")
  end
end
