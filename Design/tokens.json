{
  "$schema": "https://www.designtokens.org/TR/drafts/format/",
  "$description": "RoadPrint design tokens. Single source for generated Swift constants; plan \u00a75.1. Sizes on share cards are 1080\u00d71920 export pixels. Colors are sRGB hex.",
  "version": "0.3.0",
  "color": {
    "$type": "color",
    "background": {
      "$value": "#14161c"
    },
    "land": {
      "$value": "#1d2029"
    },
    "border": {
      "$value": "#30353f"
    },
    "route": {
      "$value": "#ffb547",
      "$description": "Amber route with a soft glow"
    },
    "text": {
      "$value": "#f0efec"
    },
    "textSecondary": {
      "$value": "#a6aab4"
    },
    "heat": {
      "1": {
        "$value": "#8a4a12"
      },
      "2": {
        "$value": "#c2650f"
      },
      "3": {
        "$value": "#f08c1a"
      },
      "4": {
        "$value": "#ffb547"
      },
      "5": {
        "$value": "#ffe1a0"
      },
      "$description": "Heatmap ramp, one hue dim \u2192 bright. Levels: 1\u20132, 3\u20135, 6\u20139, 10\u201314, 15+ trips (plan \u00a74.5)"
    },
    "card": {
      "$value": "#1d2029"
    },
    "accentText": {
      "$value": "#ffb547"
    },
    "buttonPrimary": {
      "$value": "#ffb547"
    },
    "buttonPrimaryLabel": {
      "$value": "#16181d"
    }
  },
  "font": {
    "$type": "fontFamily",
    "text": {
      "$value": "Inter"
    },
    "number": {
      "$value": "Barlow Condensed",
      "$description": "Big numbers and card titles"
    }
  },
  "terrain": {
    "$description": "Terrain share card (ADR 0001). Engineering limits (mesh size, footprint minimum, quality thresholds) are not tokens.",
    "recipeVersion": {
      "$type": "string",
      "$value": "terrain-style-3"
    },
    "export": {
      "$type": "dimension",
      "width": {
        "$value": 1080
      },
      "height": {
        "$value": 1920
      }
    },
    "safeArea": {
      "$type": "dimension",
      "$description": "Keep text and markers out of the Stories/TikTok UI zones",
      "top": {
        "$value": 220
      },
      "bottom": {
        "$value": 320
      },
      "side": {
        "$value": 72
      }
    },
    "layout": {
      "$type": "dimension",
      "kickerBaseline": {
        "$value": 272
      },
      "titleBaseline": {
        "$value": 362
      },
      "titleLineHeight": {
        "$value": 88
      },
      "titleMaxLines": {
        "$type": "number",
        "$value": 2
      },
      "reliefTop": {
        "$value": 380,
        "$description": "Relief frame is full-bleed, 1080 wide"
      },
      "reliefHeight": {
        "$value": 900
      },
      "reliefFadeTop": {
        "$value": 200,
        "$description": "Fade relief into background over this many px"
      },
      "reliefFadeBottom": {
        "$value": 220
      },
      "reliefDepthFill": {
        "$type": "number",
        "$value": 0.7,
