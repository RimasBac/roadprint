{
  "$schema": "https://www.designtokens.org/TR/drafts/format/",
  "$description": "RoadPrint design tokens. Single source for generated Swift constants; plan §5.1. Sizes on share cards are 1080×1920 export pixels. Colors are sRGB hex.",
  "version": "0.1.0",
  "color": {
    "$type": "color",
    "background": {
      "$value": "#14161c"
    },
    "land": {
      "$value": "#1d2029"
    },
    "border": {
      "$value": "#30353f"
    },
    "route": {
      "$value": "#ffb547",
      "$description": "Amber route with a soft glow"
    },
    "text": {
      "$value": "#f0efec"
    },
    "textSecondary": {
      "$value": "#a6aab4"
    },
    "heat": {
      "$description": "Heatmap ramp, one hue dim → bright. Levels: 1–2, 3–5, 6–9, 10–14, 15+ trips (plan §4.5)",
      "1": {
        "$value": "#8a4a12"
      },
      "2": {
        "$value": "#c2650f"
      },
      "3": {
        "$value": "#f08c1a"
      },
      "4": {
        "$value": "#ffb547"
      },
      "5": {
        "$value": "#ffe1a0"
      }
    }
  },
  "font": {
    "$type": "fontFamily",
    "text": {
      "$value": "Inter"
    },
    "number": {
      "$value": "Barlow Condensed",
      "$description": "Big numbers and card titles"
    }
  },
  "terrain": {
    "$description": "Terrain share card (ADR 0001). Engineering limits (mesh size, footprint minimum, quality thresholds) are not tokens.",
    "recipeVersion": {
      "$type": "string",
      "$value": "terrain-style-1"
    },
    "export": {
      "$type": "dimension",
      "width": {
        "$value": 1080
      },
      "height": {
        "$value": 1920
      }
    },
    "safeArea": {
      "$type": "dimension",
      "$description": "Keep text and markers out of the Stories/TikTok UI zones",
      "top": {
        "$value": 220
      },
      "bottom": {
        "$value": 320
      },
      "side": {
        "$value": 72
      }
    },
    "layout": {
      "$type": "dimension",
      "kickerBaseline": {
        "$value": 272
      },
      "titleBaseline": {
        "$value": 362
      },
      "titleLineHeight": {
        "$value": 88
      },
      "titleMaxLines": {
        "$type": "number",
        "$value": 2
      },
      "reliefTop": {
        "$value": 380,
        "$description": "Relief frame is full-bleed, 1080 wide"
      },
      "reliefHeight": {
        "$value": 900
      },
      "reliefFadeTop": {
        "$value": 200,
        "$description": "Fade relief into background over this many px"
      },
      "reliefFadeBottom": {
        "$value": 220
      },
      "reliefDepthFill": {
        "$type": "number",
        "$value": 0.62,
        "$description": "Fraction of relief height the ground plane depth may fill; rest is for relief and fades"
      },
      "routePadding": {
        "$type": "number",
        "$value": 0.16,
        "$description": "Padding around the route bbox, fraction of extent per side"
      },
      "numberBaseline": {
        "$value": 1452
      },
      "unitGap": {
        "$value": 18
      },
      "chipTop": {
        "$value": 1494
      },
      "chipHeight": {
        "$value": 72
      },
      "chipGap": {
        "$value": 16
      },
      "chipPaddingX": {
        "$value": 28
      },
      "chipRadius": {
        "$value": 36
      },
      "roadSignSize": {
        "$value": 72
      }
    },
    "type": {
      "$description": "Card typography. size/tracking in px at 1080×1920",
      "kicker": {
        "$value": {
          "family": "Inter",
          "weight": 600,
          "size": 28,
          "tracking": 4,
          "case": "upper",
          "color": "{color.textSecondary}"
        }
      },
      "title": {
        "$value": {
          "family": "Barlow Condensed",
          "weight": 700,
          "size": 92,
          "tracking": 1,
          "case": "upper",
          "color": "{color.text}"
        }
      },
      "number": {
        "$value": {
          "family": "Barlow Condensed",
          "weight": 700,
          "size": 220,
          "tracking": 0,
          "color": "{color.text}"
        }
      },
      "unit": {
        "$value": {
          "family": "Barlow Condensed",
          "weight": 700,
          "size": 72,
          "tracking": 2,
          "case": "upper",
          "color": "{color.route}"
        }
      },
      "chip": {
        "$value": {
          "family": "Inter",
          "weight": 500,
          "size": 32,
          "tracking": 0,
          "color": "{color.text}"
        }
      },
      "summitKicker": {
        "$value": {
          "family": "Inter",
          "weight": 600,
          "size": 24,
          "tracking": 3,
          "case": "upper",
          "color": "{color.textSecondary}"
        }
      },
      "summitValue": {
        "$value": {
          "family": "Barlow Condensed",
          "weight": 600,
          "size": 64,
          "tracking": 0,
          "color": "{color.text}"
        }
      },
      "summitName": {
        "$value": {
          "family": "Inter",
          "weight": 600,
          "size": 30,
          "tracking": 0,
          "color": "{color.text}"
        }
      },
      "notice": {
        "$value": {
          "family": "Inter",
          "weight": 600,
          "size": 26,
          "tracking": 3,
          "case": "upper",
          "color": "{color.textSecondary}"
        }
      }
    },
    "chip": {
      "fill": {
        "$type": "color",
        "$value": "#1d2029"
      },
      "stroke": {
        "$type": "color",
        "$value": "#30353f"
      },
      "strokeWidth": {
        "$type": "dimension",
        "$value": 2
      }
    },
    "land": {
      "ramp": {
        "$description": "Land colour by normalised elevation t = (h − p5) / max(p99 − p5, minSpanMeters). Multiplied by hillshade afterwards",
        "$type": "gradient",
        "$value": [
          {
            "position": 0.0,
            "color": "#1d2029"
          },
          {
            "position": 0.35,
            "color": "#30353f"
          },
          {
            "position": 0.75,
            "color": "#6b6f79"
          },
          {
            "position": 1.0,
            "color": "#a6aab4"
          }
        ]
      },
      "minSpanMeters": {
        "$type": "number",
        "$value": 1500,
        "$description": "Stops flat land being stretched across the whole ramp"
      },
      "water": {
        "$type": "color",
        "$value": "#14161c",
        "$description": "Ocean at sea level; mapped lakes at their surface elevation. Not hillshaded"
      },
      "waterEdge": {
        "$type": "color",
        "$value": "#30353f",
        "$description": "1 px coastline stroke on land side"
      }
    },
    "hillshade": {
      "$type": "number",
      "lightAzimuthDeg": {
        "$value": 315,
        "$description": "Compass degrees, light from the north-west (upper left on a north-up card)"
      },
      "lightAltitudeDeg": {
        "$value": 35
      },
      "ambient": {
        "$value": 0.38
      },
      "diffuse": {
        "$value": 0.92
      },
      "max": {
        "$value": 1.18,
        "$description": "Clamp so lit slopes brighten the ramp colour at most this much"
      }
    },
    "haze": {
      "color": {
        "$type": "color",
        "$value": "#14161c"
      },
      "farOpacity": {
        "$type": "number",
        "$value": 0.55,
        "$description": "Mix towards haze colour at the far edge, linear with depth"
      }
    },
    "camera": {
      "$type": "number",
      "azimuthDeg": {
        "$value": 0,
        "$description": "Viewer looks north (north-up)"
      },
      "elevationDeg": {
        "$value": 42
      },
      "projection": {
        "$type": "string",
        "$value": "orthographic"
      },
      "exaggeration": {
        "$description": "k = clamp(targetReliefRatio × groundWidthMeters / (elevationSpanMeters × cos(elevation)), min, max). Same k for land and ribbon",
        "targetReliefRatio": {
          "$value": 0.1
        },
        "min": {
          "$value": 2
        },
        "max": {
          "$value": 25
        }
      }
    },
    "ribbon": {
      "color": {
        "$type": "color",
        "$value": "#ffb547"
      },
      "width": {
        "$type": "dimension",
        "$value": 8
      },
      "casing": {
        "$description": "Dark line under the core, above the glow; keeps amber legible over bright lit slopes (amber vs brightest relief is only 1.1:1)",
        "color": {
          "$type": "color",
          "$value": "#14161c"
        },
        "opacity": {
          "$type": "number",
          "$value": 0.6
        },
        "width": {
          "$type": "dimension",
          "$value": 13
        }
      },
      "glow": {
        "$type": "shadow",
        "$description": "Two blurred amber strokes under the core; radius = Gaussian std dev in px",
        "$value": [
          {
            "color": "#ffb547",
            "width": 14,
            "radius": 6,
            "opacity": 0.65
          },
          {
            "color": "#ffb547",
            "width": 24,
            "radius": 22,
            "opacity": 0.35
          }
        ]
      },
      "occluded": {
        "$description": "Hidden behind coarse relief: x-ray dash at the same projected position, no glow",
        "color": {
          "$type": "color",
          "$value": "#ffb547"
        },
        "opacity": {
          "$type": "number",
          "$value": 0.55
        },
        "width": {
          "$type": "dimension",
          "$value": 4
        },
        "dash": {
          "$type": "strokeStyle",
          "$value": {
            "dashArray": [
              12,
              10
            ],
            "lineCap": "butt"
          }
        }
      },
      "gap": {
        "$description": "Recording gap or invalid altitude: straight dotted link, never interpolated or glowing",
        "color": {
          "$type": "color",
          "$value": "#a6aab4"
        },
        "opacity": {
          "$type": "number",
          "$value": 0.9
        },
        "width": {
          "$type": "dimension",
          "$value": 5
        },
        "dash": {
          "$type": "strokeStyle",
          "$value": {
            "dashArray": [
              0.1,
              13
            ],
            "lineCap": "round"
          }
        }
      },
      "depthBias": {
        "$type": "dimension",
        "$value": 3,
        "$description": "Screen-space tolerance before a ribbon point counts as occluded"
      },
      "endpoint": {
        "$description": "Approximate start/end circles (trip ends are trimmed)",
        "radius": {
          "$type": "dimension",
          "$value": 16
        },
        "stroke": {
          "$type": "dimension",
          "$value": 3
        },
        "color": {
          "$type": "color",
          "$value": "#ffb547"
        },
        "fillOpacity": {
          "$type": "number",
          "$value": 0.18
        }
      }
    },
    "summit": {
      "marker": {
        "radius": {
          "$type": "dimension",
          "$value": 9
        },
        "fill": {
          "$type": "color",
          "$value": "#f0efec"
        },
        "ring": {
          "$type": "dimension",
          "$value": 4,
          "$description": "Background-colour ring around the dot for separation from the ribbon"
        }
      },
      "leader": {
        "color": {
          "$type": "color",
          "$value": "#f0efec"
        },
        "opacity": {
          "$type": "number",
          "$value": 0.7
        },
        "width": {
          "$type": "dimension",
          "$value": 2
        },
        "length": {
          "$type": "dimension",
          "$value": 120,
          "$description": "Vertical, upwards; shortened if the label would leave the relief frame"
        }
      },
      "label": {
        "$type": "dimension",
        "gapToLeader": {
          "$value": 14
        },
        "lineGap": {
          "$value": 8
        },
        "maxWidth": {
          "$value": 520
        },
        "plateOpacity": {
          "$type": "number",
          "$value": 0.85,
          "$description": "Background plate behind label for contrast over bright relief"
        },
        "platePadding": {
          "$value": 14
        },
        "plateRadius": {
          "$value": 14
        }
      }
    },
    "hiddenRoute": {
      "$description": "Hide-route variant: fixed generic backdrop (Design/cards/terrain/terrain-backdrop.svg), identical for every trip",
      "backdropOpacity": {
        "$type": "number",
        "$value": 1
      }
    }
  }
}
