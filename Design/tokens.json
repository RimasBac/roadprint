      },
      "routePadding": {
        "$type": "number",
        "$value": 0.16,
        "$description": "Padding around the route bbox, fraction of extent per side"
      },
      "numberBaseline": {
        "$value": 1452
      },
      "unitGap": {
        "$value": 18
      },
      "chipTop": {
        "$value": 1494
      },
      "chipHeight": {
        "$value": 72
      },
      "chipGap": {
        "$value": 16
      },
      "chipPaddingX": {
        "$value": 28
      },
      "chipRadius": {
        "$value": 36
      },
      "roadSignSize": {
        "$value": 72
      }
    },
    "type": {
      "$description": "Card typography. size/tracking in px at 1080\u00d71920",
      "kicker": {
        "$value": {
          "family": "Inter",
          "weight": 600,
          "size": 28,
          "tracking": 4,
          "case": "upper",
          "color": "{color.textSecondary}"
        }
      },
      "title": {
        "$value": {
          "family": "Barlow Condensed",
          "weight": 700,
          "size": 92,
          "tracking": 1,
          "case": "upper",
          "color": "{color.text}"
        }
      },
      "number": {
        "$value": {
          "family": "Barlow Condensed",
          "weight": 700,
          "size": 220,
          "tracking": 0,
          "color": "{color.text}"
        }
      },
      "unit": {
        "$value": {
          "family": "Barlow Condensed",
          "weight": 700,
          "size": 72,
          "tracking": 2,
          "case": "upper",
          "color": "{color.route}"
        }
      },
      "chip": {
        "$value": {
          "family": "Inter",
          "weight": 500,
          "size": 32,
          "tracking": 0,
          "color": "{color.text}"
        }
      },
      "summitKicker": {
        "$value": {
          "family": "Inter",
          "weight": 600,
          "size": 24,
          "tracking": 3,
          "case": "upper",
          "color": "{color.textSecondary}"
        }
      },
      "summitValue": {
        "$value": {
          "family": "Barlow Condensed",
          "weight": 600,
          "size": 64,
          "tracking": 0,
          "color": "{color.text}"
        }
      },
      "summitName": {
        "$value": {
          "family": "Inter",
          "weight": 600,
          "size": 30,
          "tracking": 0,
          "color": "{color.text}"
        }
      },
      "notice": {
        "$value": {
          "family": "Inter",
          "weight": 600,
          "size": 26,
          "tracking": 3,
          "case": "upper",
          "color": "{color.textSecondary}"
        }
      }
    },
    "chip": {
      "fill": {
        "$type": "color",
        "$value": "#1d2029"
      },
      "stroke": {
        "$type": "color",
        "$value": "#30353f"
      },
      "strokeWidth": {
        "$type": "dimension",
        "$value": 2
      }
    },
    "land": {
      "minSpanMeters": {
        "$type": "number",
        "$value": 1200,
        "$description": "Stops flat land being stretched across the whole ramp"
      },
      "$description": "Height-relative ramp is retired in style 3 (land cover gives the colour); minSpanMeters still bounds exaggeration"
    },
    "hillshade": {
      "$type": "number",
      "$description": "Per-triangle Lambert shading on the exaggerated mesh: ambient + diffuse\u00b7max(0,n\u00b7L), capped at max",
      "lightAzimuthDeg": {
        "$value": 300
      },
      "lightAltitudeDeg": {
        "$value": 32
      },
      "ambient": {
        "$value": 0.26
      },
      "diffuse": {
        "$value": 1.05
      },
      "max": {
        "$value": 1.3
      }
    },
    "haze": {
      "$description": "Atmospheric depth: far rows blend toward color by farOpacity\u00b7depth^curve",
      "color": {
        "$type": "color",
        "$value": "#14161c"
      },
      "farOpacity": {
        "$type": "number",
        "$value": 0.78
      },
      "curve": {
        "$type": "number",
        "$value": 1.5
      }
    },
    "camera": {
      "$type": "number",
      "azimuthDeg": {
        "$value": 0,
        "$description": "Viewer looks north (north-up)"
      },
      "elevationDeg": {
        "$value": 34
      },
      "projection": {
        "$type": "string",
        "$value": "orthographic"
      },
      "exaggeration": {
        "$description": "k = clamp(targetReliefRatio \u00d7 groundWidthMeters / (elevationSpanMeters \u00d7 cos(elevation)), min, max). Same k for land and ribbon",
        "targetReliefRatio": {
          "$value": 0.065
        },
        "min": {
          "$value": 1.5
        },
        "max": {
          "$value": 10
        }
      }
    },
    "ribbon": {
      "color": {
        "$type": "color",
        "$value": "#ffb547"
      },
      "width": {
        "$type": "dimension",
        "$value": 8
      },
      "casing": {
        "$description": "Dark line under the core, above the glow; keeps amber legible over bright lit slopes (amber vs brightest relief is only 1.1:1)",
        "color": {
          "$type": "color",
          "$value": "#14161c"
        },
        "opacity": {
          "$type": "number",
          "$value": 0.85
        },
        "width": {
          "$type": "dimension",
          "$value": 14
        }
      },
      "glow": {
        "$type": "shadow",
        "$description": "Two blurred amber strokes under the core; radius = Gaussian std dev in px",
        "$value": [
          {
            "color": "#ffb547",
            "width": 14,
            "radius": 6,
            "opacity": 0.65
          },
          {
            "color": "#ffb547",
            "width": 24,
            "radius": 22,
            "opacity": 0.35
          }
        ]
      },
      "occluded": {
        "$description": "Hidden behind coarse relief: x-ray dash at the same projected position, no glow",
        "color": {
          "$type": "color",
          "$value": "#ffb547"
        },
        "opacity": {
          "$type": "number",
          "$value": 0.55
        },
        "width": {
          "$type": "dimension",
          "$value": 4
        },
        "dash": {
          "$type": "strokeStyle",
          "$value": {
            "dashArray": [
              12,
              10
            ],
            "lineCap": "butt"
          }
        }
      },
      "gap": {
        "$description": "Recording gap or invalid altitude: straight dotted link, never interpolated or glowing",
        "color": {
          "$type": "color",
          "$value": "#a6aab4"
        },
        "opacity": {
          "$type": "number",
          "$value": 0.9
        },
        "width": {
          "$type": "dimension",
          "$value": 5
        },
        "dash": {
          "$type": "strokeStyle",
          "$value": {
            "dashArray": [
              0.1,
              13
            ],
            "lineCap": "round"
          }
        }
      },
      "depthBias": {
        "$type": "dimension",
        "$value": 10,
        "$description": "Screen px the terrain must rise above the sight line before a route point counts as occluded (absorbs 2\u2032 valley fill)"
      },
      "endpoint": {
        "$description": "Approximate start/end circles (trip ends are trimmed)",
        "radius": {
          "$type": "dimension",
          "$value": 16
        },
        "stroke": {
          "$type": "dimension",
          "$value": 3
        },
        "color": {
          "$type": "color",
          "$value": "#ffb547"
        },
        "fillOpacity": {
          "$type": "number",
          "$value": 0.18
        }
      }
    },
    "summit": {
      "marker": {
        "radius": {
          "$type": "dimension",
          "$value": 9
        },
        "fill": {
          "$type": "color",
          "$value": "#f0efec"
        },
        "ring": {
          "$type": "dimension",
          "$value": 4,
          "$description": "Background-colour ring around the dot for separation from the ribbon"
        }
      },
      "leader": {
        "color": {
          "$type": "color",
          "$value": "#f0efec"
        },
        "opacity": {
          "$type": "number",
          "$value": 0.7
        },
        "width": {
          "$type": "dimension",
          "$value": 2
        },
        "length": {
          "$type": "dimension",
          "$value": 120,
          "$description": "Vertical, upwards; shortened if the label would leave the relief frame"
        }
      },
      "label": {
        "$type": "dimension",
        "gapToLeader": {
          "$value": 14
        },
        "lineGap": {
          "$value": 8
        },
        "maxWidth": {
          "$value": 520
        },
        "plateOpacity": {
          "$type": "number",
          "$value": 0.85,
          "$description": "Background plate behind label for contrast over bright relief"
        },
        "platePadding": {
          "$value": 14
        },
        "plateRadius": {
          "$value": 14
        }
      }
    },
    "hiddenRoute": {
      "$description": "Hide-route card: terrain framed on the two named places\u2019 city centre points (never trip points), no route, no route light, no summit. Place pins reuse summit.marker; names use type.summitName on the summit label plate",
      "framePadding": {
        "$type": "number",
        "$value": 0.35
      }
    },
    "occlusion": {
      "$type": "number",
      "$description": "Cheap ambient occlusion: valleys darken, ridges lift. factor = clamp(1 + strength\u00b7(h \u2212 boxBlur(h, radiusCells))/span, min, max) on the mesh",
      "radiusCells": {
        "$value": 6
      },
      "strength": {
        "$value": 2.2
      },
      "min": {
        "$value": 0.5
      },
      "max": {
        "$value": 1.15
      }
    },
    "edgeFade": {
      "$type": "number",
      "$description": "Terrain dissolves into the background instead of ending in a cut slab. Fractions of the footprint over which triangles blend to color.background (smoothstep)",
      "side": {
        "$value": 0.16
      },
      "near": {
        "$value": 0.14
      },
      "far": {
        "$value": 0.2
      }
    },
    "routeLight": {
      "$description": "Warm light spilled onto terrain around the visible route (added to triangle colour, gaussian falloff). Not drawn in hide-route mode",
      "color": {
        "$type": "color",
        "$value": "#c2650f"
      },
      "radius": {
        "$type": "dimension",
        "$value": 26
      },
      "intensity": {
        "$type": "number",
        "$value": 0.35
      }
    },
    "landCover": {
      "$type": "number",
      "$description": "Ground colour = Natural Earth I land cover (public domain) at the 2\u2032 grid, graded for the dark card: lum + (c \u2212 lum)\u00b7saturation, then ^gamma \u00b7brightness, then \u00d7 hillshade \u00d7 occlusion. Extends plan \u00a75.1 at the board\u2019s request (ROA-11)",
      "saturation": {
        "$value": 1.6
      },
      "gamma": {
        "$value": 1.35
      },
      "brightness": {
        "$value": 0.64
      }
    },
    "snow": {
      "$description": "Peaks above startMeters blend toward color, full at fullMeters",
      "color": {
        "$type": "color",
        "$value": "#f0efec"
      },
      "startMeters": {
        "$type": "number",
        "$value": 2600
      },
      "fullMeters": {
        "$type": "number",
        "$value": 3300
      },
      "opacity": {
        "$type": "number",
        "$value": 0.85
      }
    },
    "water": {
      "$description": "Oceans and lakes",
      "color": {
        "$type": "color",
        "$value": "#15212e"
      },
      "edge": {
        "$type": "color",
        "$value": "#2b3d52"
      }
    }
  },
