{
  "$schema": "https://www.designtokens.org/TR/drafts/format/",
  "$description": "RoadPrint design tokens. Single source for generated Swift constants; plan \u00a75.1. Sizes on share cards are 1080\u00d71920 export pixels. Colors are sRGB hex.",
  "version": "0.3.0",
  "color": {
    "$type": "color",
    "background": {
      "$value": "#14161c"
    },
    "land": {
      "$value": "#1d2029"
    },
    "border": {
      "$value": "#30353f"
    },
    "route": {
      "$value": "#ffb547",
      "$description": "Amber route with a soft glow"
    },
    "text": {
      "$value": "#f0efec"
    },
    "textSecondary": {
      "$value": "#a6aab4"
    },
    "heat": {
      "1": {
        "$value": "#8a4a12"
      },
      "2": {
        "$value": "#c2650f"
      },
      "3": {
        "$value": "#f08c1a"
      },
      "4": {
        "$value": "#ffb547"
      },
      "5": {
        "$value": "#ffe1a0"
      },
      "$description": "Heatmap ramp, one hue dim \u2192 bright. Levels: 1\u20132, 3\u20135, 6\u20139, 10\u201314, 15+ trips (plan \u00a74.5)"
    },
    "card": {
      "$value": "#1d2029"
    },
    "accentText": {
      "$value": "#ffb547"
    },
    "buttonPrimary": {
      "$value": "#ffb547"
    },
    "buttonPrimaryLabel": {
      "$value": "#16181d"
    }
  },
  "font": {
    "$type": "fontFamily",
    "text": {
      "$value": "Inter"
    },
    "number": {
      "$value": "Barlow Condensed",
      "$description": "Big numbers and card titles"
    }
  },
  "terrain": {
    "$description": "Terrain share card (ADR 0001). Style 5 (proposal, 2026-11-24): the relief fills the whole card in perspective, from the horizon at the top to below the bottom edge; the route is framed in a middle band and the type sits on open land under soft scrims. Golden-hour light, a lifted ribbon with a ground shadow, plate-less labels. Engineering limits (mesh size, elevation source, quality thresholds) are not tokens.",
    "recipeVersion": {
      "$type": "string",
      "$value": "terrain-style-5"
    },
    "export": {
      "$type": "dimension",
      "width": {
        "$value": 1080
      },
      "height": {
        "$value": 1920
      }
    },
    "safeArea": {
      "$type": "dimension",
      "$description": "Keep text and markers out of the Stories/TikTok UI zones",
      "top": {
        "$value": 220
      },
      "bottom": {
        "$value": 320
      },
      "side": {
        "$value": 72
      }
    },
    "layout": {
      "$type": "dimension",
      "kickerBaseline": {
        "$value": 272
      },
      "titleBaseline": {
        "$value": 362
      },
      "titleLineHeight": {
        "$value": 88
      },
      "titleMaxLines": {
        "$type": "number",
        "$value": 2
      },
      "routePadding": {
        "$type": "number",
        "$value": 0.16,
        "$description": "Padding around the route bbox, fraction of extent per side"
      },
      "numberBaseline": {
        "$value": 1462
      },
      "unitGap": {
        "$value": 18
      },
      "chipTop": {
        "$value": 1500
      },
      "chipHeight": {
        "$value": 72
      },
      "chipGap": {
        "$value": 16
      },
      "chipPaddingX": {
        "$value": 28
      },
      "chipRadius": {
        "$value": 36
      },
      "roadSignSize": {
        "$value": 72
      },
      "horizonY": {
        "$value": 150,
        "$description": "Screen y of the far edge of the land (base height); a dusk band of sky above it"
      },
      "nearY": {
        "$value": 1980,
        "$description": "Screen y of the near edge: below the card, so the land runs off the bottom"
      },
      "routeBandTop": {
        "$value": 640,
        "$description": "The route (with routePadding) is framed between these two lines, clear of the title and the number"
      },
      "routeBandBottom": {
        "$value": 1150
      }
    },
    "type": {
      "$description": "Card typography. size/tracking in px at 1080\u00d71920",
      "kicker": {
        "$value": {
          "family": "Inter",
          "weight": 600,
          "size": 28,
          "tracking": 4,
          "case": "upper",
          "color": "{color.textSecondary}"
        }
      },
      "title": {
        "$value": {
          "family": "Barlow Condensed",
          "weight": 700,
          "size": 92,
          "tracking": 1,
          "case": "upper",
          "color": "{color.text}"
        }
      },
      "number": {
        "$value": {
          "family": "Barlow Condensed",
          "weight": 700,
          "size": 280,
          "tracking": 0,
          "color": "{color.text}"
        }
      },
      "unit": {
        "$value": {
          "family": "Barlow Condensed",
          "weight": 700,
          "size": 80,
          "tracking": 3,
          "case": "upper",
          "color": "{color.route}"
        }
      },
      "chip": {
        "$value": {
          "family": "Inter",
          "weight": 500,
          "size": 32,
          "tracking": 0,
          "color": "{color.text}"
        }
      },
      "summitKicker": {
        "$value": {
          "family": "Inter",
          "weight": 600,
          "size": 24,
          "tracking": 3,
          "case": "upper",
          "color": "{color.textSecondary}"
        }
      },
      "summitValue": {
        "$value": {
          "family": "Barlow Condensed",
          "weight": 600,
          "size": 64,
          "tracking": 0,
          "color": "{color.text}"
        }
      },
      "summitName": {
        "$value": {
          "family": "Inter",
          "weight": 600,
          "size": 30,
          "tracking": 0,
          "color": "{color.text}"
        }
      }
    },
    "chip": {
      "fill": {
        "$type": "color",
        "$value": "#1d2029"
      },
      "stroke": {
        "$type": "color",
        "$value": "#30353f"
      },
      "strokeWidth": {
        "$type": "dimension",
        "$value": 2
      }
    },
    "land": {
      "minSpanMeters": {
        "$type": "number",
        "$value": 1200,
        "$description": "Stops flat land being stretched across the whole ramp"
      },
      "$description": "minSpanMeters bounds exaggeration on flat land (land cover gives the colour)"
    },
    "hillshade": {
      "$type": "number",
      "$description": "Golden hour (style 4): per-vertex Lambert on the exaggerated mesh, averaged per triangle. light = ambient * ambientColor/max + diffuse * max(0, n.L) * keyColor, capped at max, multiplied into the ground colour",
      "lightAzimuthDeg": {
        "$value": 300
      },
      "lightAltitudeDeg": {
        "$value": 24
      },
      "ambient": {
        "$value": 0.34
      },
      "diffuse": {
        "$value": 1.25
      },
      "max": {
        "$value": 1.4
      },
      "keyColor": {
        "$type": "color",
        "$value": "#ffd9a8",
        "$description": "Low warm sun; rhymes with the amber route"
      },
      "ambientColor": {
        "$type": "color",
        "$value": "#6d7fa8",
        "$description": "Cool sky fill in the shadow sides"
      }
    },
    "haze": {
      "$description": "Atmospheric depth: far rows blend toward color by farOpacity\u00b7depth^curve",
      "color": {
        "$type": "color",
        "$value": "#211f29"
      },
      "farOpacity": {
        "$type": "number",
        "$value": 0.55
      },
      "curve": {
        "$type": "number",
        "$value": 1.8
      }
    },
    "camera": {
      "$type": "number",
      "azimuthDeg": {
        "$value": 0,
        "$description": "Viewer looks north (north-up)"
      },
      "elevationDeg": {
        "$value": 36,
        "$description": "Style 5. Looking down enough that land fills the card to a horizon near the top"
      },
      "projection": {
        "$type": "string",
        "$value": "orthographic"
      },
      "exaggeration": {
        "$description": "k = clamp(targetReliefRatio \u00d7 groundWidthMeters / (elevationSpanMeters \u00d7 cos(elevation)), min, max). Same k for land and ribbon",
        "targetReliefRatio": {
          "$value": 0.065
        },
        "min": {
          "$value": 1.5
        },
        "max": {
          "$value": 10
        }
      },
      "perspective": {
        "$value": 1.6,
        "$description": "Far edge drawn at 1/(1 + p) of the near scale. The mesh is a trapezoid so the relief always fills the card width"
      }
    },
    "ribbon": {
      "color": {
        "$type": "color",
        "$value": "#ffb547"
      },
      "width": {
        "$type": "dimension",
        "$value": 9
      },
      "casing": {
        "$description": "Dark line under the core, above the glow; keeps amber legible over bright lit slopes (amber vs brightest relief is only 1.1:1)",
        "color": {
          "$type": "color",
          "$value": "#14161c"
        },
        "opacity": {
          "$type": "number",
          "$value": 0.85
        },
        "width": {
          "$type": "dimension",
          "$value": 14
        }
      },
      "glow": {
        "$type": "shadow",
        "$description": "Two blurred amber strokes under the core; radius = Gaussian std dev in px",
        "$value": [
          {
            "color": "#ffb547",
            "width": 14,
            "radius": 6,
            "opacity": 0.75
          },
          {
            "color": "#ffb547",
            "width": 30,
            "radius": 24,
            "opacity": 0.4
          }
        ]
      },
      "occluded": {
        "$description": "Hidden behind coarse relief: x-ray dash at the same projected position, no glow",
        "color": {
          "$type": "color",
          "$value": "#ffb547"
        },
        "opacity": {
          "$type": "number",
          "$value": 0.55
        },
        "width": {
          "$type": "dimension",
          "$value": 4
        },
        "dash": {
          "$type": "strokeStyle",
          "$value": {
            "dashArray": [
              12,
              10
            ],
            "lineCap": "butt"
          }
        }
      },
      "gap": {
        "$description": "Recording gap or invalid altitude: straight dotted link, never interpolated or glowing",
        "color": {
          "$type": "color",
          "$value": "#a6aab4"
        },
        "opacity": {
          "$type": "number",
          "$value": 0.9
        },
        "width": {
          "$type": "dimension",
          "$value": 5
        },
        "dash": {
          "$type": "strokeStyle",
          "$value": {
            "dashArray": [
              0.1,
              13
            ],
            "lineCap": "round"
          }
        }
      },
      "depthBias": {
        "$type": "dimension",
        "$value": 10,
        "$description": "Screen px the terrain must rise above the sight line before a route point counts as occluded (absorbs 2\u2032 valley fill)"
      },
      "endpoint": {
        "$description": "Approximate start/end circles (trip ends are trimmed)",
        "radius": {
          "$type": "dimension",
          "$value": 16
        },
        "stroke": {
          "$type": "dimension",
          "$value": 3
        },
        "color": {
          "$type": "color",
          "$value": "#ffb547"
        },
        "fillOpacity": {
          "$type": "number",
          "$value": 0.18
        }
      },
      "lift": {
        "$type": "dimension",
        "$value": 7,
        "$description": "Style 4: the visible ribbon floats this many px above its ground track; occluded and gap segments stay on the ground"
      },
      "shadow": {
        "$description": "Soft shadow of the lifted ribbon on its ground track",
        "color": {
          "$type": "color",
          "$value": "#000000"
        },
        "opacity": {
          "$type": "number",
          "$value": 0.7
        },
        "width": {
          "$type": "dimension",
          "$value": 14
        },
        "blur": {
          "$type": "dimension",
          "$value": 4
        }
      }
    },
    "summit": {
      "marker": {
        "radius": {
          "$type": "dimension",
          "$value": 9
        },
        "fill": {
          "$type": "color",
          "$value": "#f0efec"
        },
        "ring": {
          "$type": "dimension",
          "$value": 4,
          "$description": "Background-colour ring around the dot for separation from the ribbon"
        }
      },
      "leader": {
        "color": {
          "$type": "color",
          "$value": "#f0efec"
        },
        "opacity": {
          "$type": "number",
          "$value": 0.85
        },
        "width": {
          "$type": "dimension",
          "$value": 2
        },
        "length": {
          "$type": "dimension",
          "$value": 120,
          "$description": "Vertical, upwards; shortened if the label would leave the relief frame"
        }
      },
      "label": {
        "$type": "dimension",
        "gapToLeader": {
          "$value": 14
        },
        "lineGap": {
          "$value": 8
        },
        "maxWidth": {
          "$value": 520
        },
        "platePadding": {
          "$value": 14,
          "$description": "Clearance kept around the label block (no plate since style 4)"
        }
      }
    },
    "hiddenRoute": {
      "$description": "Hide-route card: terrain framed on the two named places' city centre points (never trip points), no route, no route light, no summit. Place pins reuse summit.marker; names use type.summitName with terrain.textShadow",
      "framePadding": {
        "$type": "number",
        "$value": 0.35
      }
    },
    "occlusion": {
      "$type": "number",
      "$description": "Cheap ambient occlusion on the elevation grid: factor = clamp(1 + strength\u00b7(h \u2212 gaussian(h, radiusMeters))/span, min, max). Valleys darken, ridges lift",
      "strength": {
        "$value": 2.6
      },
      "min": {
        "$value": 0.5
      },
      "max": {
        "$value": 1.15
      },
      "radiusMeters": {
        "$value": 4000
      }
    },
    "edgeFade": {
      "$description": "Style 5: only the far edge melts into the sky (fraction of the ground depth, smoothstep)",
      "far": {
        "$type": "number",
        "$value": 0.08
      }
    },
    "routeLight": {
      "$description": "Warm light spilled onto terrain around the visible route (added to triangle colour, gaussian falloff). Not drawn in hide-route mode",
      "color": {
        "$type": "color",
        "$value": "#c2650f"
      },
      "radius": {
        "$type": "dimension",
        "$value": 26
      },
      "intensity": {
        "$type": "number",
        "$value": 0.35
      }
    },
    "landCover": {
      "$type": "number",
      "$description": "Ground colour = Natural Earth I land cover (public domain) at the 2\u2032 grid, graded for the dark card: lum + (c \u2212 lum)\u00b7saturation, then ^gamma \u00b7brightness, then \u00d7 hillshade \u00d7 occlusion. Extends plan \u00a75.1 at the board\u2019s request (ROA-11)",
      "saturation": {
        "$value": 1.6
      },
      "gamma": {
        "$value": 1.35
      },
      "brightness": {
        "$value": 0.64
      }
    },
    "snow": {
      "$description": "Peaks above startMeters blend toward color, full at fullMeters",
      "color": {
        "$type": "color",
        "$value": "#f0efec"
      },
      "startMeters": {
        "$type": "number",
        "$value": 2600
      },
      "fullMeters": {
        "$type": "number",
        "$value": 3300
      },
      "opacity": {
        "$type": "number",
        "$value": 0.85
      }
    },
    "water": {
      "$description": "Oceans and lakes",
      "color": {
        "$type": "color",
        "$value": "#15212e"
      },
      "edge": {
        "$type": "color",
        "$value": "#2b3d52"
      }
    },
    "sky": {
      "$description": "Above the horizon: the background lifting to a dusk band",
      "horizon": {
        "$type": "color",
        "$value": "#2e2833"
      },
      "bandAbove": {
        "$type": "dimension",
        "$value": 260
      },
      "bandBelow": {
        "$type": "dimension",
        "$value": 160
      }
    },
    "textShadow": {
      "$description": "Style 4: one soft ink shadow under all type and labels (grow 3 px, blur 6), so text holds on bright relief without plates",
      "color": {
        "$type": "color",
        "$value": "#0b0c10"
      },
      "opacity": {
        "$type": "number",
        "$value": 0.75
      },
      "spread": {
        "$type": "dimension",
        "$value": 3
      },
      "blur": {
        "$type": "dimension",
        "$value": 6
      }
    },
    "scrim": {
      "$description": "Style 5: soft background-colour gradients under the type, since the land now runs behind it",
      "top": {
        "to": {
          "$type": "dimension",
          "$value": 620
        },
        "opacity": {
          "$type": "number",
          "$value": 0.6
        }
      },
      "bottom": {
        "from": {
          "$type": "dimension",
          "$value": 1120
        },
        "opacity": {
          "$type": "number",
          "$value": 0.85
        }
      }
    },
    "flatLand": {
      "$description": "Flat land (board, 2026-11-25, option D). flatness = clamp((mountainSpanMeters \u2212 span) / (mountainSpanMeters \u2212 flatSpanMeters), 0, 1) from the land's raw height span (2nd to 99.5th percentile). Every value below blends in by flatness, so a trip with 1,500 m of relief or more renders exactly as style 5",
      "flatSpanMeters": {
        "$type": "number",
        "$value": 300,
        "$description": "At or below this span the land is fully flat"
      },
      "mountainSpanMeters": {
        "$type": "number",
        "$value": 1500,
        "$description": "At or above this span nothing changes"
      },
      "ramp": {
        "$type": "color",
        "$description": "Height colours, scaled to the trip: t = (h \u2212 low) / span across four even stops; the ground colour becomes landCover\u00b7(1 \u2212 flatness) + ramp(t)\u00b7flatness, before the light",
        "low": {
          "$value": "#183e3c",
          "$description": "Teal lowland, river valleys"
        },
        "lowMid": {
          "$value": "#365c3a"
        },
        "highMid": {
          "$value": "#70703e"
        },
        "high": {
          "$value": "#96784e",
          "$description": "Ochre upland"
        }
      },
      "lightAltitudeDeg": {
        "$type": "number",
        "$value": 15,
        "$description": "A lower sun rakes the small relief (style 5: 24\u00b0)"
      },
      "minSpanMeters": {
        "$type": "number",
        "$value": 350,
        "$description": "Lets more height through (land.minSpanMeters 1200)"
      },
      "exaggerationMax": {
        "$type": "number",
        "$value": 22,
        "$description": "camera.exaggeration.max 10"
      },
      "hazeFarOpacity": {
        "$type": "number",
        "$value": 0.45,
        "$description": "haze.farOpacity 0.55: the far uplands stay readable"
      }
    }
  },
  "print": {
    "$description": "Print share card (ROA-57): a transparent overlay for the user's own photo, from the board's v2 reference. v3 (proposal, 2026-11-24) adds a dark ink for bright photos (print.inkDark) and a sticker layout that keeps the photo clear above it (print.sticker). Every number at 1080\u00d71920 export px.",
    "recipeVersion": {
      "$type": "string",
      "$value": "print-v3"
    },
    "export": {
      "$type": "dimension",
      "width": {
        "$value": 1080
      },
      "height": {
        "$value": 1920
      }
    },
    "safeArea": {
      "$type": "dimension",
      "$description": "Keep text and marks out of the Stories/TikTok UI zones",
      "top": {
        "$value": 220
      },
      "bottom": {
        "$value": 320
      },
      "side": {
        "$value": 72
      }
    },
    "color": {
      "$type": "color",
      "ink": {
        "$value": "#0b0c10",
        "$description": "Dark used for casing, shadow and dot halos (board reference)"
      },
      "muted": {
        "$value": "#e4e5e8",
        "$description": "Date and small labels on photos: lighter than textSecondary, which is too dim on bright photos (board reference)"
      }
    },
    "layout": {
      "$type": "dimension",
      "wordmarkBaseline": {
        "$value": 268
      },
      "titleBaseline": {
        "$value": 366
      },
      "titleLineHeight": {
        "$value": 96,
        "$description": "Equal to the size, so umlauts on line 2 clear line 1"
      },
      "titleArrowWidth": {
        "$value": 50,
        "$description": "Arrow drawn as a path, so no font needs the glyph"
      },
      "titleArrowGap": {
        "$value": 22,
        "$description": "Space on each side of the arrow"
      },
      "titleArrowStroke": {
        "$value": 7
      },
      "titleSignGap": {
        "$value": 24,
        "$description": "Min space between the title and the road sign"
      },
      "dateGap": {
        "$value": 54,
        "$description": "Title baseline (last line) to date baseline"
      },
      "signHeight": {
        "$value": 132
      },
      "signTop": {
        "$value": 240
      },
      "routeTopGap": {
        "$value": 60,
        "$description": "Date baseline to the top of the route box"
      },
      "routeBoxLeft": {
        "$value": 118
      },
      "routeBoxRight": {
        "$value": 962
      },
      "routeBoxTop": {
        "$value": 480,
        "$description": "Moves down with a two-line title"
      },
      "routeBoxBottom": {
        "$value": 830
      },
      "routeBoxTallWidth": {
        "$value": 520,
        "$description": "North\u2013south routes: the box used when it draws the route larger than the wide box"
      },
      "routeBoxTallHeight": {
        "$value": 430
      },
      "routeBottomNoElevation": {
        "$value": 1105,
        "$description": "Route box bottom when the elevation strip is absent"
      },
      "elevationTop": {
        "$value": 955
      },
      "elevationBaseline": {
        "$value": 1105
      },
      "elevationKickerGap": {
        "$value": 34,
        "$description": "Kicker baseline above the strip top"
      },
      "numberBaseline": {
        "$value": 1412
      },
      "unitGap": {
        "$value": 28
      },
      "statsRule": {
        "$value": 1456
      },
      "statsLabelBaseline": {
        "$value": 1502
      },
      "statsValueBaseline": {
        "$value": 1572
      },
      "statsDividerTop": {
        "$value": 1484
      },
      "statsDividerBottom": {
        "$value": 1576
      },
      "statsDividerInset": {
        "$value": 30,
        "$description": "Divider sits this far left of a column"
      },
      "areaLabelOffset": {
        "$value": 48,
        "$description": "Ring centre to the area label edge"
      },
      "areaLabelMaxWidth": {
        "$value": 380
      },
      "labelClearance": {
        "$value": 14,
        "$description": "Min space between a label and any other mark"
