{
  "$schema": "./signs.schema.json",
  "version": 1,
  "viewBoxHeight": 64,
  "font": "Barlow Condensed",
  "fontWeight": 700,
  "minScale": 0.7,
  "margin": 4,
  "palette": {
    "interstateBlue": "#003f87",
    "interstateRed": "#bf2033",
    "white": "#ffffff",
    "black": "#111111",
    "green": "#00703c",
    "motorwayBlue": "#0079c1",
    "yellow": "#ffd200",
    "ausGreen": "#00693c",
    "ausGold": "#ffc82e",
    "ukARoadGreen": "#006b39",
    "ausGreenText": "#00663a",
    "genericFill": "#1d2029",
    "genericEdge": "#a6aab4",
    "genericText": "#f0efec"
  },
  "networks": {
    "usInterstate": {
      "template": "usInterstate",
      "accept": "^[0-9]{1,3}$",
      "wide": "usInterstate-wide",
      "wideAbove": 2,
      "small": "usInterstate-small",
      "wideSmall": "usInterstate-wide-small",
      "smallBelow": 40
    },
    "usHighway": {
      "template": "usHighway",
      "accept": "^[0-9]{1,3}$",
      "wide": "usHighway-wide",
      "wideAbove": 2
    },
    "canadaHighway": {
      "template": "canadaHighway",
      "accept": "^[0-9]{1,3}[A-Z]?$",
      "wide": "canadaHighway-wide",
      "wideAbove": 2
    },
    "eRoad": {
      "template": "eRoad",
      "accept": "^E[0-9]{1,3}$"
    },
    "ukMotorway": {
      "template": "ukMotorway",
      "accept": "^(M[0-9]{1,3}|A[0-9]{1,4}\\(M\\))$"
    },
    "ukARoad": {
      "template": "ukARoad",
      "accept": "^A[0-9]{1,4}$"
    },
    "australia": {
      "template": "australia",
      "accept": "^([ABCM][0-9]{1,3}|[0-9]{1,3})$",
      "variants": [
        {
          "match": "^[0-9]{1,3}$",
          "template": "australia-shield"
        }
      ],
      "small": "australia-shield-small",
      "smallBelow": 40
    },
    "generic": {
      "template": "generic",
      "accept": "^[A-Z0-9()-]{1,5}$"
    }
  },
