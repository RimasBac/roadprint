        }
      }
    },
    "Elapsed time": {
      "comment": "VoiceOver label for the recording timer; this is elapsed wall time, not moving time.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Elapsed time"
          }
        }
      }
    },
    "Location is off. Your trip is still open. Enable location in Settings when parked.": {
      "comment": "Inline status when permission is revoked during recording; do not interrupt the driver.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location is off. Your trip is still open. Enable location in Settings when parked."
          }
        }
      }
    },
    "Waiting for GPS. Recording will continue when a signal is available.": {
      "comment": "A3 inline status after fifteen seconds without a GPS fix.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for GPS. Recording will continue when a signal is available."
