      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start anyway"
          }
        }
      }
    },
    "Allow location in Settings to record your next trip.": {
      "comment": "A1 explanation.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow location in Settings to record your next trip."
          }
        }
      }
    },
    "Turn on Precise Location for a more accurate route, or start with approximate location.": {
      "comment": "A2 explanation.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Precise Location for a more accurate route, or start with approximate location."
