    },
    "Location is off for RoadPrint": {
      "comment": "A1 alert title; location permission was refused.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location is off for RoadPrint"
          }
        }
      }
    },
